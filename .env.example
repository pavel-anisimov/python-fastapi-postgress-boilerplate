# === Database config ===
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# SQLAlchemy connection string (change asyncpg/psycopg depending on the engine)
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/app

# === JWT ===
# REQUIRED, min 32 chars. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === CORS / Frontend ===
# comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173
# base URL used in verification/reset email links
APP_BASE_URL=http://localhost:8000
API_PORT=8000

# === SMTP (Mailpit defaults for local dev) ===
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_TLS=false
SMTP_FROM=no-reply@example.local

# === Environment flag ===
ENV=dev
